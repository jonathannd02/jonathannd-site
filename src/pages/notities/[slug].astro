---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';

interface Props {
  note: CollectionEntry<'notes'>;
  previous?: CollectionEntry<'notes'>;
  next?: CollectionEntry<'notes'>;
}

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).sort((a, b) =>
    a.data.number.localeCompare(b.data.number, 'nl', { numeric: true }),
  );

  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      previous: notes[index - 1],
      next: notes[index + 1],
    },
  }));
}

const { note, previous, next } = Astro.props;
const { Content } = await render(note);
---

<NoteLayout note={note} previous={previous} next={next}>
  <Content />
</NoteLayout>
