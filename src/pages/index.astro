---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const drafts = [
  {
    title: 'Eerst bruikbaar, dan indrukwekkend',
    category: 'systemen / bouwen',
    status: 'werkprincipe',
  },
  {
    title: 'Maak zichtbaar wanneer het misgaat',
    category: 'leren / documenteren',
    status: 'in opbouw',
  },
];

const notes = (await getCollection('notes')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number, 'nl', { numeric: true }),
);

const formatPublished = (date: Date): string => new Intl.DateTimeFormat('nl-BE', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<SiteLayout
  title="Jonathan Núñez Dhondt / Notities"
  description="Notities over software, beveiliging, agents en systemen in opbouw."
>
  <div class="site-shell" data-site-shell>
    <section class="intro" id="intro" data-hero data-intro-screen aria-label="Introductievideo">
      <video
        class="intro__video"
        autoplay
        muted
        playsinline
        preload="auto"
        poster="/media/atlas-poster.jpg"
        aria-hidden="true"
      >
        <source src="/media/atlas.mp4" type="video/mp4" />
      </video>
      <canvas class="intro__color-reveal" data-color-reveal aria-hidden="true"></canvas>
      <div class="intro__grade" aria-hidden="true"></div>
      <div class="intro__grain" aria-hidden="true"></div>
      <a class="intro__skip" data-skip-intro href="#posts">Intro overslaan</a>
    </section>

    <main id="main" class="blog-page" tabindex="-1">
      <header class="blog-header">
        <h1><a href="#posts">Jonathan Núñez Dhondt</a></h1>
        <nav aria-label="Blognavigatie">
          <a href="#posts">notities</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/jonathannd02" target="_blank" rel="noreferrer">github</a>
        </nav>
      </header>

      <section class="posts-section" id="posts" aria-labelledby="posts-title">
        <h2 id="posts-title">notities</h2>

        <ul class="post-list">
          {notes.map((note) => (
            <li class="post-item">
              <span class="post-item__status">gepubliceerd</span>
              <div>
                <h3>
                  <a class="post-item__link" href={`/notities/${note.id}/`}>{note.data.title}</a>
                </h3>
                <p>{note.data.category} / {formatPublished(note.data.published)}</p>
              </div>
            </li>
          ))}

          {drafts.map((draft) => (
            <li class="post-item">
              <span class="post-item__status">{draft.status}</span>
              <div>
                <h3>{draft.title}</h3>
                <p>{draft.category}</p>
              </div>
            </li>
          ))}
        </ul>

        <p class="posts-note">Twee ideeën staan nog in opbouw.</p>
      </section>
    </main>
  </div>
  <script src="../scripts/site.ts"></script>
</SiteLayout>